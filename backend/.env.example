# Postgres — matches docker-compose.yml
DATABASE_URL=postgres://spice:spice@localhost:5432/spice_oms

# Required. Any long random string for local use.
JWT_SECRET=dev-only-secret-change-me-in-production

PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Optional. Every one of these degrades cleanly when absent. ---
# REDIS_URL=redis://localhost:6379
# NOTIFY_DRIVER=console
# GROQ_API_KEY=              # enables the AI read of the dashboard; without it the
#                            # numbers still render and one panel is hidden
# GROQ_MODEL=openai/gpt-oss-120b
# AUTH_DISABLED=true          # skips auth for contract testing; refuses to boot in production
